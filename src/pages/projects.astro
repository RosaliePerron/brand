---
import Base from '../layouts/Base.astro';
import { projects } from '../data/site';
---

<Base title="Projects" description="Things I've built — tools, experiments, and work I'm proud of.">
  <section class="head wrap">
    <p class="eyebrow reveal">Projects</p>
    <h1 class="head__title reveal">Things I've built.</h1>
    <p class="head__sub reveal">
        Production applications built for clients and some small experiments.
    </p>
  </section>

  <section class="grid wrap">
    {
      projects.map((p) => (
        <article class="card reveal">
          <div class="card__head">
            <h2 class="card__title">{p.title}</h2>
            {p.meta && <span class="card__meta">{p.meta}</span>}
          </div>

          {p.role && <p class="card__role">{p.role}</p>}

          <p class="card__desc">{p.description}</p>

          <ul class="card__tags">
            {p.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>

          <div class="card__links">
            {p.repo && (
              <a href={p.repo} class="ulink" target="_blank" rel="noopener">
                Code ↗
              </a>
            )}
            {p.demo && (
              <a href={p.demo} class="ulink" target="_blank" rel="noopener">
                Live ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .head {
    padding-top: clamp(3rem, 10vh, 6rem);
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
  }

  .head__title {
    font-size: var(--step-3);
    margin-top: 1rem;
  }

  .head__sub {
    color: var(--ink-soft);
    font-size: var(--step-1);
    max-width: 44ch;
    margin-top: 1rem;
  }

  .grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    background: var(--paper);
    padding: clamp(1.5rem, 4vw, 2.4rem);
    display: flex;
    flex-direction: column;
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      background 0.25s ease;
  }

  .card:hover {
    background: var(--paper-2);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .card__title {
    font-size: var(--step-2);
  }

  .card__meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .card__role {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin-top: 0.6rem;
  }

  .card__desc {
    color: var(--ink-soft);
    margin-top: 0.8rem;
    flex: 1;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }

  .card__tags li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.15em 0.6em;
  }

  .card__links {
    display: flex;
    gap: 1.4rem;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
